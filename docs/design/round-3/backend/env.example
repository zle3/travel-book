# Copy to .env (rename) next to compose.yaml in the Dockge stack folder. Never commit .env.
# Generate tokens with: openssl rand -base64 48

# Public site origin (CORS allow-list)
SITE_ORIGIN=https://travel.zachle.info

# Bearer token for /v1/admin/* (Discord bot / planner routine only)
ADMIN_TOKEN=change-me

# Shared secret the Cloudflare Worker sends as X-Travel-Proxy (also set as a Worker secret)
PROXY_SECRET=change-me

# Cloudflare Tunnel token (remote-managed tunnel; public hostname api.travel.zachle.info -> http://api:8787)
TUNNEL_TOKEN=change-me

# Photon
PHOTON_REGION=us
PHOTON_UPDATE_STRATEGY=SEQUENTIAL
PUID=1000
PGID=1000

# Later (Discord)
DISCORD_PUBLIC_KEY=
DISCORD_TOKEN=
