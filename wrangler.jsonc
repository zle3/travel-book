{
  // Cloudflare Workers with static assets. The edge worker (worker/index.ts) runs first
  // for every request: bot policy, password gate, then env.ASSETS serves the static Astro build in dist/.
  // See ops/OPERATIONS.md (Hosting) and worker/README.md.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "travel-book",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  // Only public address is the custom domain. Preview aliases use versions upload (see scripts/deploy.sh).
  "workers_dev": false,
  "routes": [{ "pattern": "travel.zachle.info", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  // Non-secret vars only. PROXY_SECRET (shared with the home backend) is set with `wrangler secret put PROXY_SECRET`.
  // GATE_ALLOW_SEARCH "0": no search engine bypasses the gate (also the code default when unset).
  "vars": {
    "GATE_ALLOW_SEARCH": "0",
    // Public site (owner decision 2026-11-24): the password gate is off. Bot blocking, robots.txt and noindex stay on.
    "GATE_DISABLED": "1",
    // Owner's home backend (live Discord adds). Unreachable or unset = the site shows its offline note and keeps working.
    "BACKEND_BASE": "https://api.travel.zachle.info"
  }
}
