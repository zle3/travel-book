# Copy to .env (rename) next to compose.yaml in the Dockge stack folder. Never commit .env.
# Generate tokens with: openssl rand -base64 48
# Lines marked REQUIRED stop the stack from starting when empty.

# --- API ---------------------------------------------------------------
# REQUIRED. Bearer token for /v1/admin/* (the bot and the planner routine).
ADMIN_TOKEN=change-me
# REQUIRED. Shared secret the Cloudflare Worker sends as X-Travel-Proxy. Set it on the Worker FIRST
# (npx wrangler secret put PROXY_SECRET), then here.
PROXY_SECRET=change-me
# Public site origin (CORS allow-list for tiles)
SITE_ORIGIN=https://travel.zachle.info

# --- Tunnel ------------------------------------------------------------
# REQUIRED. Remote-managed Cloudflare Tunnel token (public hostname api.travel.zachle.info -> http://api:8787)
TUNNEL_TOKEN=change-me

# --- Discord bot -------------------------------------------------------
# REQUIRED. Bot token from the Discord developer portal. Enable the "Message Content Intent" for the bot there.
DISCORD_BOT_TOKEN=change-me
# REQUIRED. Numeric id of the #planner channel (Discord developer mode, right click, Copy Channel ID).
DISCORD_PLANNER_CHANNEL_ID=000000000000000000
# REQUIRED. Your own Discord user id. Posts and reaction taps from anyone else are ignored.
DISCORD_OWNER_ID=000000000000000000

# --- AI parsing (optional; costs money per post) -------------------------
# Leave ANTHROPIC_API_KEY empty to skip AI parsing: the bot still reacts, replies "Queued for the next planner run",
# and the scheduled planner routine files the post. Setting a key turns parsing on at the next restart,
# and queued posts are picked up on the next pass.
ANTHROPIC_API_KEY=
# Model used for parsing. The default is the most capable current Opus. Change it only if you want a different price/quality tradeoff.
ANTHROPIC_MODEL=claude-opus-5-5
# Minutes between catch-up passes (missed posts, reactions tapped while offline, parse retries).
CHECK_INTERVAL_MIN=5
