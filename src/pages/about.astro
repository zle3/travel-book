---
import Page from "../layouts/Page.astro";
import { CONTACT } from "../data/content";
---
<Page title="About" description="About this site.">
  <section class="page-hero"><div class="wrap stack"><h1>About</h1><p class="lead">Replace with the real story, from PRODUCT.md only.</p></div></section>
  <section class="section" id="contact">
    <div class="wrap"><div class="prose">
      <h2>Contact</h2>
      <p>This section is a placeholder for the project's contact block. Contact details are owner-only: they live in <code>src/data/content.ts</code> and show as <span class="badge badge--sample">Sample</span> until the owner supplies them.</p>
      <ul>
        {CONTACT.map((c) => <li><strong>{c.label}:</strong> {c.value} {c.placeholder && <span class="badge badge--sample">Sample</span>}</li>)}
      </ul>
    </div></div>
  </section>
</Page>
