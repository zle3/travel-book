---
import { ICONS } from "../lib/icons";
interface Props { name: string; class?: string; label?: string }
const { name, class: cls = "", label } = Astro.props;
const body = ICONS[name] ?? "";
---
<svg class={`ico ${cls}`.trim()} viewBox="0 0 24 24" aria-hidden={label ? undefined : "true"} role={label ? "img" : undefined} aria-label={label} focusable="false" set:html={body} />
