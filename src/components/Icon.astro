---
/** Inline-sprite icon (the sprite is inlined once in index.astro so CSS can reach its .f and .s classes). */
interface Props { name: string; class?: string }
const { name, class: cls = "" } = Astro.props;
---
<svg class={`ic ${cls}`.trim()} aria-hidden="true" focusable="false"><use href={`#${name}`} /></svg>
