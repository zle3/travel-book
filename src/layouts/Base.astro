---
/** Document shell: head metadata, global CSS, theme and device class before first paint. The explorer page uses this directly. */
import "../styles/global.css";
import { SITE } from "../lib/site";
// Icon cache-bust version. Bump when the logo files in public/ change so browsers refetch them.
const ICON_VER = "2";
interface Props { title: string; description?: string; path?: string; bodyClass?: string }
const { title, description = SITE.description, path = Astro.url.pathname, bodyClass } = Astro.props;
const canonical = new URL(path, SITE.url).href;
const image = new URL(SITE.previewImage, SITE.url).href;
---
<!doctype html>
<html lang="en" class="no-js" data-theme-key={SITE.themeKey}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Public site, but never indexed (owner decision 2026-11-24). Do not loosen without the owner. -->
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href={`/favicon.svg?v=${ICON_VER}`} />
    <link rel="icon" href={`/favicon.ico?v=${ICON_VER}`} sizes="32x32" />
    <link rel="apple-touch-icon" href={`/apple-touch-icon.png?v=${ICON_VER}`} />
    <link rel="manifest" href={`/site.webmanifest?v=${ICON_VER}`} />
    <meta name="theme-color" content="#1e1520" />
    <link rel="preload" href="/fonts/figtree-600.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/figtree-400.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // Before first paint: dark unless the visitor chose light; phone or desktop layout class (no flash).
      (function () {
        var d = document.documentElement;
        d.classList.remove("no-js");
        var t = null;
        try { t = localStorage.getItem(d.dataset.themeKey); } catch (e) {}
        d.dataset.theme = t === "light" ? "light" : "dark";
        d.classList.add(innerWidth >= 900 ? "desktop" : "phone");
      })();
    </script>
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
