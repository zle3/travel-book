---
/** Standard page: header, <main id="main">, footer. Pages pass a title and put the content in the slot. */
import Base from "./Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
interface Props { title: string; description?: string; bodyClass?: string }
const { title, description, bodyClass } = Astro.props;
---
<Base title={title} description={description} bodyClass={bodyClass}>
  <Header />
  <main id="main" class="main"><slot /></main>
  <Footer />
</Base>
